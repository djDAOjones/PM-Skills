# OS files
.DS_Store
Thumbs.db

# Editor state
*.swp
*.swo
*~

# Node tooling (dev-only; never committed, never distributed).
# package-lock.json IS committed for reproducible CI installs.
node_modules/
npm-debug.log*

# The repo's own pm-skills deployment (self/) is TRACKED — contract,
# living project memory, and archived history (versioned backup on a
# cloud-synced path). It is source-only (never distributed). The living
# memory is lint-gated; only the cold tiers (self/archive/,
# self/evaluations/, self/_transcripts/, self/field-reports/*/) are
# excluded, via .markdownlint-cli2.jsonc, cspell.json,
# .editorconfig-checker.json, and scripts/check-docs.mjs.

# Exception: the janitor report is generated each session and read
# from the filesystem (freshness contract: timestamp + Start SHA),
# so it is not tracked (REPORTS-IGNORE, 2026-08-17).
self/project/reports/

# Field reports from consuming projects that cannot be public stay on
# the maintainer's checkout only (FIELD-REPORTS local lane, 2026-08-23):
# the tier is tracked in a public repo, so each project's `local/`
# subdirectory is ignored. See self/field-reports/README.md → "Local-only
# lane".
self/field-reports/*/local/
